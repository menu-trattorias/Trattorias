# Supabase Configuration (Client & Cloudflare Pages Function fallback)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Server-side Supabase overrides for /api/health (falls back to VITE_SUPABASE_* if omitted)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Private Health-Check Authentication Token (Server-side only — never prefix with VITE_)
# Configure the real secret in Cloudflare Pages -> Settings -> Environment variables (Production & Preview)
HEALTH_CHECK_TOKEN=your_generated_secure_token

# Optional: Restrict admin dashboard strictly to specific admin emails (comma-separated).
# If omitted, any authenticated Supabase auth user in your project is authorized.
# VITE_ADMIN_EMAILS=admin@trattorias.com,manager@trattorias.com
